# ─────────────────────────────────────────────────────────────────────────────
# NewsCrawl Intelligence Platform — LOCAL environment
# Copy to `env.local` and adjust. `env.local` is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

NEWSCRAWL_ENV=local

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=newscrawl
POSTGRES_USER=newscrawl
POSTGRES_PASSWORD=newscrawl-local-dev
DATABASE_URL=postgresql+asyncpg://newscrawl:newscrawl-local-dev@localhost:5433/newscrawl

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380/0

# ── Object storage (MinIO locally, any S3-compatible in prod) ────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=newscrawl
S3_SECRET_KEY=newscrawl-local-dev
S3_BUCKET_RAW_HTML=newscrawl-raw-html
S3_REGION=us-east-1

# ── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=local-dev-secret-change-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Initial admin user (seeded by `make seed`)
ADMIN_EMAIL=admin@newscrawl.dev
ADMIN_PASSWORD=admin-local-dev

# ── LLM providers ────────────────────────────────────────────────────────────
# Chain: Gemini → DeepSeek → Ollama. Local-only: LLM_PROVIDER=ollama.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
LLM_FALLBACK_PROVIDERS=deepseek,ollama

# ── Embeddings ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu
# Leave empty when the API process loads sentence-transformers itself.
# In docker prod, compose sets this to http://processor-embedding:8081.
EMBEDDING_SERVICE_URL=

# ── Crawler ──────────────────────────────────────────────────────────────────
CRAWLER_USER_AGENT="NewsCrawlBot/0.1 (+https://newscrawl.musfiqdehan.com/bot)"
CRAWLER_MAX_CONCURRENCY=8

# ── Web dashboard ────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://localhost:8000

# ── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
METRICS_PORT=9100

# ── Article retention ────────────────────────────────────────────────────────
ARTICLE_RETENTION_HOURS=24
ARTICLE_RETENTION_INTERVAL_HOURS=12
