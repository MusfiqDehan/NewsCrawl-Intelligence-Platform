# ─────────────────────────────────────────────────────────────────────────────
# NewsCrawl Intelligence Platform — PRODUCTION environment
# Copy to `env.prod` on the server and fill in real secrets. NEVER commit it.
# ─────────────────────────────────────────────────────────────────────────────

NEWSCRAWL_ENV=prod

# ── Public URLs (behind central Traefik) ─────────────────────────────────────
WEB_DOMAIN=newscrawl.musfiqdehan.com
API_DOMAIN=newscrawl-api.musfiqdehan.com

# ── PostgreSQL (internal network — not published to host) ────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=newscrawl
POSTGRES_USER=newscrawl
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DATABASE_URL=postgresql+asyncpg://newscrawl:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/newscrawl

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Object storage ───────────────────────────────────────────────────────────
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=REPLACE_WITH_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_SECRET_KEY
S3_BUCKET_RAW_HTML=newscrawl-raw-html
S3_REGION=us-east-1

# ── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ALLOWED_ORIGINS=https://newscrawl.musfiqdehan.com

ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── LLM providers ────────────────────────────────────────────────────────────
# Hybrid (when cloud quota is healthy):
#   LLM_PROVIDER=gemini
#   LLM_FALLBACK_PROVIDERS=ollama
# Local-only (no API keys required; recommended when Gemini returns 429):
#   LLM_PROVIDER=ollama
#   LLM_FALLBACK_PROVIDERS=
LLM_PROVIDER=gemini
GEMINI_API_KEY=REPLACE_WITH_GEMINI_KEY
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
# qwen2.5:1.5b is the CPU default under load; use qwen2.5:3b/7b with more RAM/GPU.
OLLAMA_MODEL=qwen2.5:1.5b
LLM_FALLBACK_PROVIDERS=ollama
LLM_TIMEOUT_SECONDS=600

# ── Embeddings ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu
# Prod API sets EMBEDDING_SERVICE_URL=http://processor-embedding:8081 via compose
# so query encode reuses the worker model (API image has no torch).

# ── Crawler ──────────────────────────────────────────────────────────────────
CRAWLER_USER_AGENT="NewsCrawlBot/0.1 (+https://newscrawl.musfiqdehan.com/bot)"
CRAWLER_MAX_CONCURRENCY=16

# ── Web dashboard ────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://newscrawl-api.musfiqdehan.com
API_INTERNAL_URL=http://api:8000

# ── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
METRICS_PORT=9100
