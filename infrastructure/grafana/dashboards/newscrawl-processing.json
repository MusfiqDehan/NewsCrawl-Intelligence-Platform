{
  "uid": "newscrawl-processing",
  "title": "NewsCrawl — Processing & LLM",
  "tags": ["newscrawl", "processor", "llm"],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Queue depth per stage",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "newscrawl_queue_depth",
          "legendFormat": "{{stream}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Messages processed by outcome (rate, 5m)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (worker, outcome) (rate(newscrawl_processor_messages_total[5m]))",
          "legendFormat": "{{worker}}/{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Processing p95 duration per worker",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, worker) (rate(newscrawl_processor_duration_seconds_bucket[5m])))",
          "legendFormat": "{{worker}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Embeddings written + duplicates found (rate, 5m)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (kind) (rate(newscrawl_embeddings_total[5m]))",
          "legendFormat": "embed {{kind}}",
          "refId": "A"
        },
        {
          "expr": "sum by (method) (rate(newscrawl_duplicates_total[5m]))",
          "legendFormat": "dup {{method}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "LLM token consumption (rate, 5m)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum by (provider, kind) (rate(newscrawl_llm_tokens_total[5m]))",
          "legendFormat": "{{provider}} {{kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "LLM spend (total, USD)",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 16 },
      "targets": [
        { "expr": "sum(newscrawl_llm_cost_usd_total)", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4 }, "overrides": [] }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Live processor workers",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 16 },
      "targets": [
        { "expr": "newscrawl_workers_alive{worker_type=\"processor\"}", "refId": "A" }
      ]
    }
  ]
}
