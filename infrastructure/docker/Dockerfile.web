# NewsCrawl web — Next.js operations dashboard
# Build from the repository root:
#   docker build -f infrastructure/docker/Dockerfile.web \
#     --build-arg NEXT_PUBLIC_API_URL=https://newscrawl-api.musfiqdehan.com .

FROM node:22-alpine AS deps
WORKDIR /app
RUN corepack enable
COPY apps/web/package.json apps/web/pnpm-lock.yaml apps/web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

FROM node:22-alpine AS builder
WORKDIR /app
RUN corepack enable
COPY --from=deps /app/node_modules ./node_modules
COPY apps/web/ ./
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL NEXT_TELEMETRY_DISABLED=1 CI=true
RUN pnpm build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
RUN addgroup -S newscrawl && adduser -S newscrawl -G newscrawl
COPY --from=builder --chown=newscrawl:newscrawl /app/.next/standalone ./
COPY --from=builder --chown=newscrawl:newscrawl /app/.next/static ./.next/static
COPY --from=builder --chown=newscrawl:newscrawl /app/public ./public
USER newscrawl
EXPOSE 3000
ENV PORT=3000 HOSTNAME=0.0.0.0
CMD ["node", "server.js"]
