# NewsCrawl API — FastAPI control/query plane
# Build from the repository root:
#   docker build -f infrastructure/docker/Dockerfile.api .

FROM ghcr.io/astral-sh/uv:python3.14-bookworm-slim AS builder
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app

# Dependency layer: only manifests, so code edits don't bust the cache.
COPY pyproject.toml uv.lock ./
COPY apps/api/pyproject.toml apps/api/
COPY apps/crawler/pyproject.toml apps/crawler/
COPY apps/processor/pyproject.toml apps/processor/
COPY packages/contracts/pyproject.toml packages/contracts/
COPY packages/crawler-utils/pyproject.toml packages/crawler-utils/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-workspace --package newscrawl-api

COPY packages/ packages/
COPY apps/api/ apps/api/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --package newscrawl-api

FROM python:3.14-slim-bookworm
RUN groupadd -r newscrawl && useradd -r -g newscrawl newscrawl \
    && apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder --chown=newscrawl:newscrawl /app /app
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1
USER newscrawl
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -fsS http://localhost:8000/api/v1/health || exit 1
CMD ["uvicorn", "newscrawl_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
