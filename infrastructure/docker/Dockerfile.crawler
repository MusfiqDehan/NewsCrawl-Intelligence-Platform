# NewsCrawl crawler — Scrapy + Playwright crawl plane
# Build from the repository root:
#   docker build -f infrastructure/docker/Dockerfile.crawler .

FROM ghcr.io/astral-sh/uv:python3.14-bookworm-slim AS builder
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY apps/api/pyproject.toml apps/api/
COPY apps/crawler/pyproject.toml apps/crawler/
COPY apps/processor/pyproject.toml apps/processor/
COPY packages/contracts/pyproject.toml packages/contracts/
COPY packages/crawler-utils/pyproject.toml packages/crawler-utils/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-workspace \
    --package newscrawl-crawler --package newscrawl-api

COPY packages/ packages/
COPY apps/api/ apps/api/
COPY apps/crawler/ apps/crawler/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --package newscrawl-crawler --package newscrawl-api

FROM python:3.14-slim-bookworm
WORKDIR /app
COPY --from=builder /app /app
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    SCRAPY_SETTINGS_MODULE=newscrawl_crawler.settings
# Chromium + system deps for the Playwright fallback.
RUN playwright install --with-deps chromium && rm -rf /var/lib/apt/lists/*
RUN groupadd -r newscrawl && useradd -r -g newscrawl -m newscrawl \
    && chown -R newscrawl:newscrawl /app /ms-playwright
USER newscrawl
EXPOSE 9101
CMD ["python", "-m", "newscrawl_crawler.run_worker", "--max-pages", "25", "--batch-size", "10", "--interval", "5"]
